#!/usr/bin/env bash
#
# Runs the same checks CI runs, so a green local commit means a green build.
# Install with: make hooks
#
# Skip once with: git commit --no-verify

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if command -v detect-secrets-hook >/dev/null 2>&1 && [[ -f "$repo_root/.secrets.baseline" ]]; then
  echo "==> detect-secrets"
  staged="$(git diff --staged --name-only --diff-filter=ACM)"
  if [[ -n "$staged" ]]; then
    # No xargs: --no-run-if-empty is GNU-only and absent on macOS.
    echo "$staged" | tr '\n' '\0' \
      | xargs -0 detect-secrets-hook --baseline "$repo_root/.secrets.baseline"
  fi
fi

exec "$repo_root/ci/verify.sh"
