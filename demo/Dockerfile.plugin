# Carries the plugin binary into the cluster so an initContainer can copy it
# into the controller pod. This is also the pattern air-gapped clusters use,
# since they cannot download from a `location:` URL.
FROM alpine:3.20
COPY rollouts-plugin-metric-instana /plugin/rollouts-plugin-metric-instana
RUN chmod +x /plugin/rollouts-plugin-metric-instana
